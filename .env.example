# Copy to .env.local for local development, and add the same values in your
# hosting provider's environment-variable settings. Never commit real values.
# None of these use the NEXT_PUBLIC_ prefix, so they stay on the server.

# --- Google Sheets (membership register) ---
# Service account email, e.g. sdf-membership@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key from the service account JSON file ("private_key"), on one line with \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The long ID in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
# Name of the tab that holds registrations (default: Registrations)
GOOGLE_SHEET_TAB=Registrations

# --- Payment details shown after registration (optional) ---
# Membership fee in rupees, numbers only. Leave empty to use the default (₹999).
MEMBERSHIP_FEE_INR=
# UPI ID shown under the QR code. Leave empty to hide it.
MEMBERSHIP_UPI_ID=

# --- New-registration alerts (optional; each one is skipped if left empty) ---
# WhatsApp via CallMeBot (free). Your number with country code, e.g. +919876543210
CALLMEBOT_PHONE=
# The API key CallMeBot sends you on WhatsApp after you activate it
CALLMEBOT_API_KEY=
# Email via Gmail (free). The Gmail address that sends the alert
GMAIL_USER=
# A Gmail App Password (Google Account > Security > App passwords), not your normal password
GMAIL_APP_PASSWORD=
# Where alerts go. Leave empty to send them to GMAIL_USER itself.
NOTIFY_EMAIL_TO=
